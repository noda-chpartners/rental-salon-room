---
import { MapPin, TrainFront, Clock3, CalendarOff, Building2, DoorOpen } from '@lucide/astro';
import SectionTitle from './SectionTitle.astro';

const details = [
  { label: '経営会社名', value: '合同会社STELLA BAS', icon: Building2 },
  { label: '住所', value: '香川県高松市', icon: MapPin },
  { label: '最寄駅', value: 'JR四国 高徳線 昭和町駅', icon: TrainFront },
  { label: '営業時間', value: '平日・土日祝 9:00〜24:00', icon: Clock3 },
  { label: '定休日', value: '年末年始', icon: CalendarOff },
  { label: '部屋数', value: '直接電話にてお問い合わせください', icon: DoorOpen },
];
---

<section class="information" id="information">
  <div class="information__inner container">
    <div class="information__heading-wrap">
      <SectionTitle eyebrow="INFORMATION" title="店舗情報" />
      <p class="information__area">KAGAWA · TAKAMATSU</p>
    </div>

    <dl class="information__list">
      {details.map(({ label, value, icon: Icon }) => (
        <div class="information__row reveal">
          <dt class="information__term">
            <span class="information__term-icon"><Icon size={16} stroke-width={1.3} aria-hidden="true" /></span>
            {label}
          </dt>
          <dd class="information__description">{value}</dd>
        </div>
      ))}
      <div class="information__row reveal">
        <dt class="information__term">電話番号</dt>
        <dd class="information__description">
          <a class="information__phone site-link focusable" href="tel:08090000764">080-9000-0764</a>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style lang="scss">
  .information {
    position: relative;
    padding: clamp(8rem, 13vw, 12rem) 0;
    color: var(--color-ink);
    background: var(--color-paper-deep);

    &__inner {
      display: grid;
      grid-template-columns: minmax(17rem, 0.75fr) minmax(27rem, 1.25fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: start;
    }

    &__heading-wrap {
      position: sticky;
      top: 8rem;
      display: grid;
      gap: 3rem;
    }

    &__area {
      width: max-content;
      padding: 0.65rem 1rem;
      color: var(--color-accent);
      border: 1px solid rgba(154, 118, 86, 0.3);
      border-radius: 999px;
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.22em;
    }

    &__list {
      padding: 0 clamp(1.25rem, 3vw, 2.5rem);
      background: rgba(255, 253, 249, 0.62);
      border: 1px solid rgba(48, 45, 41, 0.1);
      border-radius: 1.5rem;
      box-shadow: 0 1.5rem 4rem rgba(69, 56, 43, 0.055);
    }

    &__row {
      display: grid;
      grid-template-columns: minmax(8.5rem, 0.65fr) 1.35fr;
      gap: 1rem;
      padding: 1.75rem 0;
      border-bottom: 1px solid var(--color-line);
    }

    &__row:last-child {
      border-bottom: 0;
    }

    &__term {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      color: rgba(48, 45, 41, 0.52);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.11em;
    }

    &__term-icon {
      display: grid;
      width: 2rem;
      height: 2rem;
      place-items: center;
      color: var(--color-accent);
      background: var(--color-paper);
      border-radius: 50%;
    }

    &__description {
      align-self: center;
      font-family: var(--font-serif);
      font-size: clamp(0.98rem, 1.55vw, 1.18rem);
      letter-spacing: 0.035em;
    }

    &__phone {
      position: relative;
      display: inline-block;
      color: var(--color-accent);
      font-size: clamp(1.35rem, 2.8vw, 2.15rem);
      letter-spacing: 0.04em;
      line-height: 1.2;
      white-space: nowrap;
    }

    &__phone::after {
      position: absolute;
      right: 0;
      bottom: -0.35rem;
      left: 0;
      height: 1px;
      background: currentColor;
      content: "";
      transform: scaleX(0.25);
      transform-origin: left;
      transition: transform 0.5s var(--ease-out-expo);
    }

    &__phone:hover::after {
      transform: scaleX(1);
    }
  }

  @media (max-width: 850px) {
    .information {
      &__inner {
        grid-template-columns: 1fr;
      }

      &__heading-wrap {
        position: static;
      }
    }
  }

  @media (max-width: 560px) {
    .information {
      &__row {
        grid-template-columns: 1fr;
        gap: 0.8rem;
      }
    }
  }
</style>
