---
import { ArrowUpRight, MapPinned, Sparkles, UserRound } from '@lucide/astro';
import SectionTitle from './SectionTitle.astro';

const audiences = [
  {
    number: '01',
    label: 'INDEPENDENT',
    lines: ['個人セラピスト'],
    icon: UserRound,
  },
  {
    number: '02',
    label: 'MULTI AREA',
    lines: ['出張など、各地で活動する', 'セラピスト'],
    icon: MapPinned,
  },
  {
    number: '03',
    label: 'EARLY STAGE',
    lines: ['予約数がまだ少ない', 'セラピスト'],
    icon: Sparkles,
  },
];
---

<section class="audience">
  <div class="audience__orbit audience__orbit--large" aria-hidden="true"></div>
  <div class="audience__orbit audience__orbit--small" aria-hidden="true"></div>

  <div class="audience__inner container">
    <div class="audience__heading">
      <SectionTitle
        eyebrow="FOR THERAPISTS"
        title="こんなセラピストの方へ。"
        description="固定の場所に縛られず、予約に合わせて施術スペースを使いたい方におすすめです。"
        theme="dark"
      />
      <p class="audience__heading-index reveal" aria-hidden="true">02 / FOR YOU</p>
    </div>

    <ol class="audience__list site-list">
      {audiences.map(({ number, label, lines, icon: Icon }) => (
        <li class="audience__item reveal">
          <div class="audience__card-head">
            <span class="audience__number">{number}</span>
            <span class="audience__icon"><Icon size={23} stroke-width={1.15} aria-hidden="true" /></span>
          </div>
          <div class="audience__card-content">
            <p class="audience__label">{label}</p>
            <h3 class="audience__title">
              {lines.map((line) => <span class="audience__title-line">{line}</span>)}
            </h3>
          </div>
          <span class="audience__arrow"><ArrowUpRight size={24} stroke-width={1.1} aria-hidden="true" /></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style lang="scss">
  .audience {
    position: relative;
    padding: clamp(8rem, 14vw, 13rem) 0;
    color: var(--color-white);
    background: #3a3631;
    overflow: hidden;

    &__inner {
      position: relative;
      z-index: 2;
      display: grid;
      gap: clamp(5rem, 10vw, 9rem);
    }

    &__heading {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
      align-items: end;
    }

    &__heading-index {
      padding-bottom: 0.5rem;
      color: rgba(255, 253, 249, 0.38);
      font-family: var(--font-serif);
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      white-space: nowrap;
    }

    &__list {
      position: relative;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.5rem;
    }

    &__item {
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto;
      min-height: 17rem;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      color: var(--color-ink);
      background: var(--color-white);
      border-radius: 1.5rem;
      box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.13);
      overflow: hidden;
      transition: transform 0.55s var(--ease-out-expo), box-shadow 0.55s var(--ease-out-expo);
    }

    &__item::before {
      position: absolute;
      right: -4.5rem;
      bottom: -6.5rem;
      width: 15rem;
      height: 15rem;
      border: 1px solid currentColor;
      border-radius: 50%;
      content: "";
      opacity: 0.1;
    }

    &__item:nth-child(1) {
      grid-column: 1 / span 7;
    }

    &__item:nth-child(2) {
      grid-column: 6 / span 7;
      color: var(--color-white);
      background: var(--color-accent);
    }

    &__item:nth-child(3) {
      grid-column: 2 / span 8;
      color: var(--color-ink);
      background: var(--color-sand);
    }

    &__item:hover {
      z-index: 2;
      box-shadow: 0 2.8rem 6rem rgba(0, 0, 0, 0.2);
      transform: translateY(-0.75rem) rotate(-0.5deg);
    }

    &__item:nth-child(2):hover {
      transform: translateY(-0.75rem) rotate(0.5deg);
    }

    &__card-head {
      grid-column: 1 / -1;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }

    &__number {
      font-family: var(--font-serif);
      font-size: clamp(3rem, 5vw, 5rem);
      letter-spacing: -0.06em;
      line-height: 0.9;
      opacity: 0.28;
    }

    &__icon {
      display: grid;
      width: 3.6rem;
      height: 3.6rem;
      place-items: center;
      color: var(--color-accent);
      background: var(--color-paper);
      border-radius: 50%;
    }

    &__item:nth-child(2) .audience__icon {
      color: var(--color-white);
      background: rgba(255, 255, 255, 0.13);
      border: 1px solid rgba(255, 255, 255, 0.22);
    }

    &__card-content {
      align-self: end;
    }

    &__label {
      margin-bottom: 0.8rem;
      font-size: 0.56rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      opacity: 0.55;
    }

    &__title {
      font-family: var(--font-serif);
      font-size: clamp(1.45rem, 2.6vw, 2.3rem);
      font-weight: 400;
      letter-spacing: -0.025em;
      line-height: 1.45;
    }

    &__title-line {
      display: block;
      white-space: nowrap;
    }

    &__arrow {
      align-self: end;
      display: grid;
      width: 3.25rem;
      height: 3.25rem;
      place-items: center;
      border: 1px solid currentColor;
      border-radius: 50%;
      opacity: 0.55;
      transition: color 0.35s ease, background 0.35s ease, transform 0.35s var(--ease-out-expo);
    }

    &__item:hover .audience__arrow {
      color: var(--color-white);
      background: var(--color-ink);
      border-color: var(--color-ink);
      opacity: 1;
      transform: rotate(45deg);
    }

    &__item:nth-child(2):hover .audience__arrow {
      color: var(--color-ink);
      background: var(--color-white);
      border-color: var(--color-white);
    }

    &__orbit {
      position: absolute;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 50%;
      pointer-events: none;
    }

    &__orbit--large {
      top: -22rem;
      right: -16rem;
      width: 52rem;
      height: 52rem;
    }

    &__orbit--small {
      bottom: -18rem;
      left: -13rem;
      width: 36rem;
      height: 36rem;
    }
  }

  @media (max-width: 850px) {
    .audience {
      &__heading {
        grid-template-columns: 1fr;
      }

      &__heading-index {
        display: none;
      }

      &__list {
        grid-template-columns: 1fr;
      }

      &__item,
      &__item:nth-child(1),
      &__item:nth-child(2),
      &__item:nth-child(3) {
        grid-column: auto;
      }
    }
  }

  @media (max-width: 560px) {
    .audience {
      &__item {
        min-height: 15rem;
      }

      &__title {
        font-size: clamp(1.18rem, 5.6vw, 1.55rem);
      }

      &__arrow {
        width: 2.8rem;
        height: 2.8rem;
      }
    }
  }
</style>
