---
import { Phone } from '@lucide/astro';
---

<header class="header" data-header>
  <a class="header__brand site-link focusable" href="#top" aria-label="ページ上部へ">
    <span class="header__brand-mark">R</span>
    <span class="header__brand-copy">
      <span class="header__brand-name">RENTAL ESTHE ROOM</span>
      <span class="header__brand-area">TAKAMATSU</span>
    </span>
  </a>

  <nav class="header__nav" aria-label="メインナビゲーション">
    <a class="header__nav-link site-link focusable" href="#benefits">メリット</a>
    <a class="header__nav-link site-link focusable" href="#information">店舗情報</a>
  </nav>

  <a class="header__contact site-link focusable" href="tel:08090000764" data-magnetic>
    <Phone class="header__contact-icon" size={15} stroke-width={1.4} aria-hidden="true" />
    <span class="header__contact-label">電話で問い合わせる</span>
  </a>
</header>

<style lang="scss">
  .header {
    position: fixed;
    z-index: 50;
    top: 1rem;
    left: 50%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(calc(100% - 2rem), 1440px);
    padding: 0.65rem 0.75rem 0.65rem 1rem;
    color: var(--color-ink);
    background: rgba(255, 253, 249, 0.76);
    border: 1px solid rgba(48, 45, 41, 0.11);
    border-radius: 999px;
    box-shadow: 0 0.8rem 3rem rgba(48, 45, 41, 0.05);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
    transition: background 0.5s ease, box-shadow 0.5s ease;

    &.is-scrolled {
      background: rgba(255, 253, 249, 0.94);
      box-shadow: 0 0.8rem 3rem rgba(48, 45, 41, 0.1);
    }

    &__brand {
      display: inline-flex;
      align-items: center;
      justify-self: start;
      gap: 0.75rem;
    }

    &__brand-mark {
      display: grid;
      width: 2.1rem;
      height: 2.1rem;
      place-items: center;
      color: var(--color-white);
      background: var(--color-ink);
      border-radius: 50%;
      font-family: var(--font-serif);
      font-size: 0.9rem;
    }

    &__brand-copy {
      display: grid;
      line-height: 1.2;
    }

    &__brand-name {
      font-family: var(--font-serif);
      font-size: 0.65rem;
      letter-spacing: 0.13em;
    }

    &__brand-area {
      color: var(--color-accent);
      font-size: 0.48rem;
      font-weight: 700;
      letter-spacing: 0.27em;
    }

    &__nav {
      display: flex;
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    &__nav-link {
      position: relative;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.13em;
    }

    &__nav-link::after {
      position: absolute;
      right: 0;
      bottom: -0.3rem;
      left: 0;
      height: 1px;
      background: var(--color-accent);
      content: "";
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.45s var(--ease-out-expo);
    }

    &__nav-link:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    &__contact {
      display: inline-flex;
      align-items: center;
      justify-self: end;
      gap: 0.55rem;
      padding: 0.72rem 1rem;
      color: var(--color-white);
      background: var(--color-ink);
      border-radius: 999px;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      transition: background 0.35s ease;
    }

    &__contact:hover {
      background: var(--color-accent);
    }
  }

  @media (max-width: 760px) {
    .header {
      top: 0.75rem;
      grid-template-columns: 1fr auto;
      width: calc(100% - 1.5rem);

      &__nav,
      &__brand-copy,
      &__contact-label {
        display: none;
      }

      &__contact {
        width: 2.65rem;
        height: 2.65rem;
        justify-content: center;
        padding: 0;
      }
    }
  }
</style>
